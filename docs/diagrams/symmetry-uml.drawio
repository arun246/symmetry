<mxCell id="c36" value="Sockets are language- and cell-agnostic seams.&lt;br&gt;V1 wires only the COMPUTE cell (WorkKind.COMPUTE).&lt;br&gt;Keycard.EMPTY: no network, no filesystem, no clock, no randomness, 1 thread.&lt;br&gt;Gate = a LIST of Checkers (property, fuzz, differential, holdout, OOD).&lt;br&gt;Correctness is a gate; MetricVector only ranks submissions that already pass." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="730" height="150" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="pg6" name="06 · database schema (ER)">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="780" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="c2" value="CONTRACT&lt;br&gt;----&lt;br&gt;id              UUID PK  gen_random_uuid()&lt;br&gt;module_id       TEXT  NOT NULL (not blank)&lt;br&gt;version         TEXT  NOT NULL (not blank)&lt;br&gt;task_kind       TEXT  CHECK optimize|build&lt;br&gt;language        TEXT  NOT NULL&lt;br&gt;disclosure_tier TEXT  CHECK L0|L1|L2&lt;br&gt;work_kind       TEXT  CHECK COMPUTE|SERVICE|UI|DATA|SYSTEM&lt;br&gt;lifecycle_state TEXT  CHECK DRAFT..MERGED&lt;br&gt;task_document   TEXT  NOT NULL&lt;br&gt;payload         JSONB CHECK object&lt;br&gt;created_at      TIMESTAMPTZ now()&lt;br&gt;updated_at      TIMESTAMPTZ trigger&lt;br&gt;&lt;br&gt;UNIQUE (module_id, version)&lt;br&gt;GIN   (payload jsonb_path_ops)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="60" width="440" height="460" as="geometry"/></mxCell>
<mxCell id="c3" value="ACCEPTANCE&lt;br&gt;----&lt;br&gt;id                UUID PK  gen_random_uuid()&lt;br&gt;contract_id       UUID FK → contract.id&lt;br&gt;worker_id         TEXT  NOT NULL (not blank)&lt;br&gt;task_document_hash TEXT NOT NULL&lt;br&gt;signature         TEXT  NOT NULL&lt;br&gt;worker_public_key TEXT  NOT NULL&lt;br&gt;verified          BOOLEAN default false&lt;br&gt;agreements        JSONB CHECK array&lt;br&gt;accepted_at       TIMESTAMPTZ now()&lt;br&gt;&lt;br&gt;UNIQUE (contract_id, worker_id)&lt;br&gt;INDEX  (worker_id)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="120" width="440" height="330" as="geometry"/></mxCell>
<mxCell id="e4" value="1 : N  acceptances   ON DELETE CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;jettySize=auto;orthogonalLoop=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;edgeStyle=entityRelationEdgeStyle;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c5" value="Flyway owns DDL: platform/src/main/resources/db/migration/V1__baseline.sql&lt;br&gt;Hibernate runs with ddl-auto=validate, so these diagrams stay in lockstep.&lt;br&gt;Every write goes through JPA repositories; no ad-hoc SQL in app code.&lt;br&gt;The UNIQUE (contract_id, worker_id) rule is what turns a duplicate accept into HTTP 409." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="1020" height="150" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
